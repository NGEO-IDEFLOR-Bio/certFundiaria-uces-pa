flowchart TD
    classDef ideflor fill:#D5F5E3,stroke:#27AE60,stroke-width:2px,color:#1E8449
    classDef documento fill:#E8DAEF,stroke:#8E44AD,stroke-width:2px,color:#6C3483
    classDef decisao fill:#FFF9C4,stroke:#F1C40F,stroke-width:2px,color:#5D4037
    classDef rejeicao fill:#FADBD8,stroke:#E74C3C,stroke-width:2px,color:#922B21
    classDef inicio fill:#FFFFFF,stroke:#2C3E50,stroke-width:2px,color:#2C3E50

    REC["📥 Recebimento do processo do ITERPA com CACLG"]:::inicio
    --> AUT["📋 Presidência: Autuação e Distribuição Interna"]:::ideflor

    AUT --> S1["1️⃣ NGEO - Sensoriamento Remoto e Parecer"]:::ideflor
    S1 --> S2["2️⃣ DGMUC - Análise de Pertinência"]:::ideflor
    S2 --> S3["3️⃣ Procuradoria - Análise Jurídica"]:::ideflor
    S3 --> S4["4️⃣ Presidência - Deliberação Final"]:::ideflor

    S4 --> DELIB{"Deliberação da Presidência"}:::decisao

    DELIB --> |Deferimento com/sem condicionantes| EMITCH["📜 Emissão da CH"]:::documento
    DELIB --> |Indeferimento| INDEF["❌ Notificação ao requerente e ITERPA<br/>Recurso: 15d úteis"]:::rejeicao
    DELIB --> |Diligências complementares| DILIG["🔄 Retorno ao passo pertinente"]:::decisao

    EMITCH --> CHOK["✅ Certidão de Habilitação Emitida<br/>Validade: 2 anos (+2 prorrogável)"]:::documento
    CHOK --> F3(("🔄 INÍCIO DA FASE III")):::inicio

    style F3 stroke:#E67E22,stroke-width:4px,color:#935116
    style CHOK stroke-width:3px
