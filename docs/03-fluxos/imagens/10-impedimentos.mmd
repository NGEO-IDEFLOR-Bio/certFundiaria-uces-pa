flowchart TD
    classDef bloqueio fill:#FADBD8,stroke:#C0392B,stroke-width:2px,color:#922B21
    classDef exececao fill:#FEF9E7,stroke:#F4D03F,stroke-width:2px,color:#7D6608
    classDef check fill:#D6EAF8,stroke:#2980B9,stroke-width:2px,color:#1B4F72
    classDef ok fill:#D5F5E3,stroke:#27AE60,stroke-width:2px,color:#1E8449
    classDef titulo fill:#FFFFFF,stroke:#2C3E50,stroke-width:3px,color:#2C3E50

    TITULO["🚫 IMPEDIMENTOS À INCORPORAÇÃO<br/><b>Art. 6º da IN Conjunta</b>"]:::titulo

    TITULO --> V1

    V1{"1. Pendências na cadeia dominial?"}:::check
    V1 --> |Sim| B1["🚫 VEDADO<br/><b>Salvo sentença transitada em julgado</b>"]:::bloqueio
    V1 --> |Não| OK1["✅ Passou"]:::ok

    OK1 --> V2{"2. Litígio judicial ou administrativo?"}:::check
    V2 --> |Sim| B2["🚫 VEDADO<br/><b>Salvo decisão administrativa definitiva</b>"]:::bloqueio
    V2 --> |Não| OK2["✅ Passou"]:::ok

    OK2 --> V3{"3. Passivos ambientais consolidados incompatíveis?"}:::check
    V3 --> |Sim| B3["🚫 VEDADO<br/>Incompatível com objetivos da UCES"]:::bloqueio
    V3 --> |Não| OK3["✅ Passou"]:::ok

    OK3 --> V4{"4. Sobreposição com áreas de regularização de comunidades?"}:::check
    V4 --> |Sim| B4["🚫 VEDADO<br/>Indígenas, quilombolas ou tradicionais"]:::bloqueio
    V4 --> |Não| OK4["✅ Passou"]:::ok

    OK4 --> V5{"5. CAR inativo ou irregular no SICAR?"}:::check
    V5 --> |Sim| B5["🚫 VEDADO<br/>CAR deve estar ativo e regular"]:::bloqueio
    V5 --> |Não| OK5["✅ Passou"]:::ok

    OK5 --> V6{"6. Edificações incompatíveis com UCES?"}:::check
    V6 --> |Sim| E1["⚠️ VEDADO<br/><b>Salvo plano de adequação aprovado pelo IDEFLOR-Bio</b>"]:::exececao
    V6 --> |Não| APROVADO["✅ IMÓVEL HABILITADO para prosseguimento"]:::ok

    style TITULO stroke-width:3px
    style B1 stroke-width:2px
    style B2 stroke-width:2px
    style B3 stroke-width:2px
    style B4 stroke-width:2px
    style B5 stroke-width:2px
    style E1 stroke-width:2px
    style APROVADO stroke-width:4px
