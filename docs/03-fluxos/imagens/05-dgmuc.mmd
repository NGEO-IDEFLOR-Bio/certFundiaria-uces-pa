flowchart TD
    classDef ideflor fill:#D5F5E3,stroke:#27AE60,stroke-width:2px,color:#1E8449
    classDef decisao fill:#FFF9C4,stroke:#F1C40F,stroke-width:2px,color:#5D4037
    classDef rejeicao fill:#FADBD8,stroke:#E74C3C,stroke-width:2px,color:#922B21
    classDef entrada fill:#FFFFFF,stroke:#2C3E50,stroke-width:2px,color:#2C3E50

    IN["📥 Relatório/Parecer NGEO recebido"]:::entrada
    --> DGMUC["🏛️ DGMUC - Análise de Pertinência"]:::ideflor

    DGMUC --> A1["📍 Inserção integral ou parcial na UCES"]:::ideflor
    A1 --> A2["📋 Compatibilidade com categoria de manejo da UCES receptora"]:::ideflor
    A2 --> A3["🎯 Importância estratégica para consolidação/ampliação da UCES"]:::ideflor
    A3 --> A4["🌳 Corredores ecológicos, áreas de sensibilidade, remanescentes"]:::ideflor
    A4 --> A5["📐 Conformidade com o Plano de Gestão da UCES"]:::ideflor

    A5 --> RESULT{"Resultado da Nota Técnica"}:::decisao

    RESULT --> |Pertinência| PROC(("➡️ Encaminha à Procuradoria")):::entrada
    RESULT --> |Impertinência| IMPERT["⚠️ Encaminha à Presidência<br/>com notificação ao requerente"]:::rejeicao

    style PROC stroke:#27AE60,stroke-width:3px,color:#1E8449
